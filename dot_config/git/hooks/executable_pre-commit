#!/bin/sh
# -----------------------------------------------------------------------------
# Git Hook: pre-commit
# 暗号化されていない平文ファイルに機密キーワードが含まれていないか検査
# -----------------------------------------------------------------------------

secret_check() {
  # スキップ用環境変数
  if [ "${SKIP_SECRET_CHECK:-0}" = "1" ]; then
    return 0
  fi

  DENY_FILE="${HOME}/.config/git/deny_words"
  [ -f "${DENY_FILE}" ] || return 0

  # 個人・公開リポジトリのみを対象にし、業務リポジトリでの誤検知を防ぐ
  remote_url="$(git remote get-url origin 2>/dev/null || true)"
  repo_name="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo '')")"
  user_email="$(git config user.email 2>/dev/null || true)"

  is_target=0
  if echo "${remote_url}" | grep -Eq 'github\.com[:/]akameco/'; then
    is_target=1
  elif [ "${repo_name}" = "dotfiles" ]; then
    is_target=1
  elif [ "${user_email}" = "akameco.t@gmail.com" ]; then
    is_target=1
  fi

  [ "${is_target}" -eq 1 ] || return 0

  # ステージされた平文ファイルを取得（*.age や *.gpg などの暗号化ファイルを除外）
  staged_files="$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(age|gpg)$' || true)"
  [ -z "${staged_files}" ] && return 0

  # パターンファイルの準備（コメント行と空行を除去）
  TMP_PAT="$(mktemp)"
  trap 'rm -f "${TMP_PAT}"' EXIT INT TERM
  grep -v '^[[:space:]]*#' "${DENY_FILE}" | grep -v '^[[:space:]]*$' > "${TMP_PAT}"

  [ -s "${TMP_PAT}" ] || return 0

  # 平文ファイルの追加行（+で始まる行）を検査（diffヘッダ +++ は除外）
  matched=""
  for file in ${staged_files}; do
    file_diff="$(git diff --cached -U0 -- "${file}" | grep '^+[^+]' | sed 's/^+//' || true)"
    if [ -n "${file_diff}" ]; then
      hit="$(echo "${file_diff}" | grep -i -F -f "${TMP_PAT}" || true)"
      if [ -n "${hit}" ]; then
        matched="${matched}\n[File: ${file}]\n${hit}"
      fi
    fi
  done

  if [ -n "${matched}" ]; then
    echo ""
    echo "❌ [SECURITY ERROR] 暗号化されていない平文ファイルに機密キーワードが検知されました！"
    echo "--------------------------------------------------"
    printf "%b\n" "${matched}"
    echo "--------------------------------------------------"
    echo "社名・組織名・案件ドメインなどは平文ファイルに含めず、"
    echo "chezmoi の暗号化ファイル (*.age) に記述するか、汎用的な表現に置き換えてください。"
    echo "※ 緊急回避する場合は SKIP_SECRET_CHECK=1 git commit または git commit --no-verify"
    echo ""
    return 1
  fi

  return 0
}

# dotfiles リポジトリでの構文チェック（zsh / sh / bash / json）
dotfiles_syntax_check() {
  repo_top="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"
  [ "$(basename "${repo_top}")" = "dotfiles" ] || return 0

  staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"
  [ -z "${staged_files}" ] && return 0

  syntax_err=0
  for file in ${staged_files}; do
    case "${file}" in
      *.tmpl|*.age|*.gpg) continue ;;
    esac
    full_path="${repo_top}/${file}"
    [ -f "${full_path}" ] || continue

    case "${file}" in
      *.zsh|*dot_zshrc*|*dot_zshenv*|*dot_zprofile*)
        if command -v zsh >/dev/null 2>&1; then
          zsh -n "${full_path}" || syntax_err=1
        fi
        ;;
      *.sh|*executable_*)
        first_line="$(head -n 1 "${full_path}" 2>/dev/null || true)"
        case "${first_line}" in
          *zsh*)  command -v zsh >/dev/null 2>&1 && { zsh -n "${full_path}" || syntax_err=1; } ;;
          *bash*) command -v bash >/dev/null 2>&1 && { bash -n "${full_path}" || syntax_err=1; } ;;
          *sh*)   sh -n "${full_path}" || syntax_err=1 ;;
        esac
        ;;
      *.json)
        if command -v jq >/dev/null 2>&1; then
          jq empty "${full_path}" >/dev/null || syntax_err=1
        fi
        ;;
    esac
  done

  if [ "${syntax_err}" -ne 0 ]; then
    echo "❌ [SYNTAX ERROR] ステージされた設定ファイルに構文エラーがあります。" >&2
    return 1
  fi

  # dotfiles リポジトリで、ソースと $HOME の不一致を知らせる（止めない）
  if command -v chezmoi >/dev/null 2>&1; then
    drift="$(chezmoi status 2>/dev/null)"
    [ -n "${drift}" ] && printf '⚠ chezmoi のソースと $HOME がずれています（apply か re-add）:\n%s\n' "${drift}" >&2
  fi
  return 0
}

# リポジトリ固有の .git/hooks/pre-commit があれば続けて実行する（core.hooksPath でグローバルに向けると素通りされるため）
run_repo_hook() {
  repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-commit"
  [ -x "${repo_hook}" ] || return 0
  [ "$(cd "$(dirname "${repo_hook}")" && pwd -P)" = "$(cd "$(dirname "$0")" && pwd -P)" ] && return 0
  "${repo_hook}" "$@"
}

secret_check || exit $?
dotfiles_syntax_check || exit $?
run_repo_hook "$@"
