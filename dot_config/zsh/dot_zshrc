# ~/.config/zsh/.zshrc

if [[ -f "${ZDOTDIR:-$HOME/.config/zsh}/functions.zsh" ]]; then
  source "${ZDOTDIR:-$HOME/.config/zsh}/functions.zsh"
fi

# 履歴設定
setopt histignorealldups sharehistory
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
HISTFILE="${ZDOTDIR:-$HOME/.config/zsh}/.zsh_history"
HISTSIZE=5000
SAVEHIST=5000

# Homebrew (Apple Silicon)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null
fi

# 対話シェル専用設定
if [[ $- == *i* ]]; then
  # mise (direnv代替 / ランタイム管理)
  if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
  fi

  # Starship prompt（超軽量モダン）
  if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
  fi

  # zoxide（cd の代替）
  if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
  fi

  # fzf キーバインド・補完（Ctrl-R: 履歴検索, Ctrl-T: ファイル選択, Alt-C: ディレクトリ移動）
  if (( $+commands[fzf] )); then
    if (( $+commands[rg] )); then
      export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
      export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi

    # Ctrl-R: 行番号を隠し、コマンドだけを見やすく並べる
    export FZF_CTRL_R_OPTS=$'--height 50% --reverse --border --info=inline --prompt="履歴 > " --with-nth=2.. --exact'
    export FZF_CTRL_T_OPTS=$'--height 50% --reverse --border --info=inline --prompt="ファイル > "'
    export FZF_ALT_C_OPTS=$'--height 50% --reverse --border --info=inline --prompt="ディレクトリ > "'

    eval "$(fzf --zsh)"

    # cd の直後はカレントディレクトリ直下のディレクトリ一覧、cat/bat の直後は ls 結果（通常を先、隠しを後）を表示する
    fzf-file-widget() {
      local FZF_CTRL_T_COMMAND="$FZF_CTRL_T_COMMAND"
      local is_local_ls=0
      if [[ "$LBUFFER" =~ '(^|[;&|])[[:space:]]*(builtin[[:space:]]+|command[[:space:]]+)?cd([[:space:]]+-[^[:space:]]*)*[[:space:]]*$' ]]; then
        FZF_CTRL_T_COMMAND='{ command ls -1ALp | /usr/bin/grep -E "^[^.].*[/]$" | /usr/bin/sed "s|[/]$||"; command ls -1ALp | /usr/bin/grep -E "^\..*[/]$" | /usr/bin/sed "s|[/]$||"; } || true'
        is_local_ls=1
      elif [[ "$LBUFFER" =~ '(^|[;&|])[[:space:]]*(builtin[[:space:]]+|command[[:space:]]+)?(cat|bat)([[:space:]]+-[^[:space:]]*)*[[:space:]]*$' ]]; then
        FZF_CTRL_T_COMMAND='{ command ls -1A | /usr/bin/grep -v "^\."; command ls -1A | /usr/bin/grep "^\."; } || true'
        is_local_ls=1
      fi
      local selected
      selected=$(__fzf_select)
      local ret=$?
      if [[ -n "$selected" ]]; then
        if (( is_local_ls )) && [[ "$LBUFFER" != *[[:space:]] ]]; then
          LBUFFER="${LBUFFER} ${selected}"
        else
          LBUFFER="${LBUFFER}${selected}"
        fi
      fi
      zle reset-prompt
      return $ret
    }

    # Ctrl-R: 履歴表示時に $HOME を ~ に、~/dev/github.com を  に省略し、同一コマンドとして重複排除する（確定時は ~/dev/github.com/... として挿入）
    fzf-history-widget() {
      local selected extracted_with_perl=0
      setopt localoptions noglobsubst noposixbuiltins pipefail no_aliases no_glob no_sh_glob no_ksharrays extendedglob 2> /dev/null
      if zmodload -F zsh/parameter p:{commands,history} 2>/dev/null && (( ${+commands[perl]} )); then
        extracted_with_perl=1
        selected="$(printf '%s\t%s\000' "${(kv)history[@]}" |
          perl -0 -ne 's{(?:^|[\s=;:])\K\Q$ENV{HOME}\E(?=/|\s|$|\0)}{~}g; s{\bcd -- (?=~(?:/|\s|$|\0))}{cd }g; if (!$seen{(/^\s*[0-9]+\**\t(.*)/s, $1)}++) { s{(?:^|[\s=;:])\K~/dev/github\.com(?=/|\s|$|\0)}{\xef\x82\x9b}g; s/\n/\n\t/g; print; }' |
          FZF_DEFAULT_OPTS=$(__fzf_defaults "" "-n2..,.. --scheme=history --bind=ctrl-r:toggle-sort,alt-r:toggle-raw --wrap-sign '\t↳ ' --highlight-line --multi ${FZF_CTRL_R_OPTS-} --query=${(qqq)LBUFFER} --read0") \
          FZF_DEFAULT_OPTS_FILE='' $(__fzfcmd))"
      else
        selected="$(fc -rl 1 | __fzf_exec_awk '{ cmd=$0; sub(/^[ \t]*[0-9]+\**[ \t]+/, "", cmd); if (!seen[cmd]++) print $0 }' |
          FZF_DEFAULT_OPTS=$(__fzf_defaults "" "-n2..,.. --scheme=history --bind=ctrl-r:toggle-sort,alt-r:toggle-raw --wrap-sign '\t↳ ' --highlight-line --multi ${FZF_CTRL_R_OPTS-} --query=${(qqq)LBUFFER}") \
          FZF_DEFAULT_OPTS_FILE='' $(__fzfcmd))"
      fi
      local ret=$?
      local -a cmds
      local -a mbegin mend match
      if [ -n "$selected" ]; then
        if ((( extracted_with_perl )) && [[ $selected == <->$'\t'* ]]) ||
        ((( ! extracted_with_perl )) && [[ $selected == [[:blank:]]#<->(  |\* )* ]]); then
          for line in ${(ps:\n:)selected}; do
            if (( extracted_with_perl )); then
              if [[ $line == (#b)(<->)(#B)$'\t'* ]]; then
                if (( ${+history[${match[1]}]} )); then
                  local cmd="${history[${match[1]}]}"
                  cmd="$(printf '%s' "$cmd" | perl -0 -pe 's{(?:^|[\s=;:])\K\Q$ENV{HOME}\E(?=/|\s|$)}{~}g; s{\bcd -- (?=~(?:/|\s|$))}{cd }g')"
                  cmds+=("$cmd")
                fi
              fi
            elif [[ $line == [[:blank:]]#(#b)(<->)(#B)(  |\* )* ]]; then
              zle .push-line
              zle vi-fetch-history -n ${match[1]}
              (( ${#BUFFER} )) && cmds+=("${BUFFER}")
              BUFFER=""
              zle .get-line
            fi
          done
          if (( ${#cmds[@]} )); then
            BUFFER="${(pj:\n:)${(@)cmds%%$'\n'#}}"
            CURSOR=${#BUFFER}
          fi
        else
          LBUFFER="$selected"
        fi
      fi
      zle reset-prompt
      return $ret
    }
  fi

  # Shift+Enter を通常の改行として扱う（ターミナルからの独自コード対策）
  bindkey -M emacs '\e[27;2;13~' accept-line
  bindkey -M viins '\e[27;2;13~' accept-line

  # ghq + fzf jump
  if [[ -n ${functions[fzf-zoxide-cd]} ]]; then
    zle -N fzf-zoxide-cd
    bindkey '^G' fzf-zoxide-cd
  fi

  # Ctrl+eで外部エディタを開く
  autoload -U edit-command-line
  zle -N edit-command-line
  bindkey '^E' edit-command-line

  # GitHub CLI 補完 (必要ならアンコメント)
  # (( $+commands[gh] )) && eval "$(gh completion -s zsh)"

  # zsh-autosuggestions (入力履歴からの補完サジェスト)
  if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=242'
    # Ctrl+F でサジェストを確定
    bindkey -M emacs '^F' autosuggest-accept
    bindkey -M viins '^F' autosuggest-accept

    # Tab: サジェストがあれば確定、無ければ通常の補完を実行（cd 入力中は履歴サジェストではなく通常の補完を優先）
    # ※ _ で始まるウィジェット名にすることで zsh-autosuggestions の自動ラップによる POSTDISPLAY の事前クリアを防ぐ
    _autosuggest_tab() {
      if [[ "$LBUFFER" =~ '(^|[;&|])[[:space:]]*(builtin[[:space:]]+|command[[:space:]]+)?cd([[:space:]]+|$)' ]]; then
        zle autosuggest-clear 2>/dev/null
        zle fzf-completion 2>/dev/null || zle expand-or-complete
      elif [[ -n "$POSTDISPLAY" ]]; then
        zle autosuggest-accept
      else
        zle fzf-completion 2>/dev/null || zle expand-or-complete
      fi
    }
    zle -N _autosuggest_tab
    bindkey -M emacs '^I' _autosuggest_tab
    bindkey -M viins '^I' _autosuggest_tab
    bindkey -M emacs '\t' _autosuggest_tab
    bindkey -M viins '\t' _autosuggest_tab
  fi
fi

(( $+commands[bat] )) && alias cat='bat'

# 基本補完 (zcompdump が最新ならキャッシュを再利用)
autoload -Uz compinit
zmodload zsh/complist 2>/dev/null
_zcompdump_file="${ZDOTDIR:-$HOME/.config/zsh}/.zcompdump"
if [[ ! -f "$_zcompdump_file" || "${ZDOTDIR:-$HOME/.config/zsh}/.zshrc" -nt "$_zcompdump_file" ]]; then
  compinit
else
  compinit -C
fi
unset _zcompdump_file

# 安全な削除
alias rm='trash'
alias realrm='/bin/rm'

# Git 操作用
alias g='git'
alias gs='git status'
alias ga='git add .'
alias gb='gb-fzf'
alias gc='git commit -m'
alias gp='git pull'
alias gwc='gwt-clean-merged'  # マージ済み worktree を一括削除
alias gw='gwt-fzf'  # fzf で worktree を選択 (PR title 表示) してブランチごと移動

alias vim='nvim'
alias vi='nvim'
alias v.='nvim .'
alias m='nvim ~/Memo/memo.md'

# herdr-companion の plugin（hook と /companion）を常に読み込む。リポジトリのファイルを直接読むので git pull で更新される
alias claude='claude --plugin-dir "$HOME/dev/github.com/akameco/herdr-companion/plugins/herdr-companion"'
alias ai='claude --dangerously-skip-permissions'
alias gemini='agy --dangerously-skip-permissions'
alias agy='agy --dangerously-skip-permissions'

if (( $+commands[nvim] )); then
  export EDITOR='nvim'
  export VISUAL='nvim'
fi

export PATH="$HOME/.local/bin:$PATH"

export DEV_DIR="${HOME}/dev/github.com/akameco"
export DOT_DIR="${DEV_DIR}/dotfiles"

if (( $+commands[eza] )); then
  alias la='eza -alh --no-user --time-style=long-iso --sort=modified --reverse --icons'
  alias lad='eza -alh --no-user --time-style=long-iso --sort=modified --reverse --icons --group-directories-first'
else
  alias la='ls -alh'
  alias lad='ls -alh'
fi


# 会社・秘密の環境変数や設定（age で暗号化管理）
if [[ -f "${ZDOTDIR:-$HOME/.config/zsh}/work.zsh" ]]; then
  source "${ZDOTDIR:-$HOME/.config/zsh}/work.zsh"
fi

