#!/usr/bin/env bash
set -euo pipefail

echo "Hello $(whoami)! Setting up your Mac..."

# 1. Xcode Command Line Tools
if ! xcode-select -p >/dev/null 2>&1; then
  echo "Installing Xcode Command Line Tools…"
  xcode-select --install || {
    echo "インストーラが完了したら再実行してください"
    exit 1
  }
  read -rp "インストール完了後に Enter を押してください…" _
fi

# 2. Homebrew
if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew…"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
fi

# 3. chezmoi & git & gh
brew install chezmoi git gh

DEV_DIR="${HOME}/dev/github.com/akameco"
DOT_DIR="${DEV_DIR}/dotfiles"
mkdir -p "${DEV_DIR}"

if [ ! -d "${DOT_DIR}" ]; then
  echo "Cloning dotfiles with gh…"
  gh repo clone akameco/dotfiles "${DOT_DIR}"
fi

# chezmoi のソースディレクトリリンク
mkdir -p "${HOME}/.local/share"
if [ ! -e "${HOME}/.local/share/chezmoi" ]; then
  ln -s "${DOT_DIR}" "${HOME}/.local/share/chezmoi"
fi

if [ ! -f "${HOME}/.config/chezmoi/key.txt" ]; then
  echo "注意: age 秘密鍵 (~/.config/chezmoi/key.txt) がまだ配置されていません。"
  echo "新規マシンの場合はパスワードマネージャー等から key.txt を配置してから chezmoi apply してください。"
fi

# 4. chezmoi 初期化と適用
# （Brewfile パッケージのインストールや macOS defaults 設定も chezmoi scripts 経由で自動実行されます）
echo "Applying chezmoi dotfiles..."
chezmoi apply --source="${DOT_DIR}"

echo "Setup completed! 必要に応じてログアウトまたは再起動してください。"
