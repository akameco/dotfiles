<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>dev.akameco.babyfirst-site-update</string>
    <key>ProgramArguments</key>
    <array>
      <string>{{ .chezmoi.homeDir }}/.local/share/mise/shims/bun</string>
      <string>{{ .chezmoi.homeDir }}/dev/github.com/akameco/tokyo-babyfirst-catalog/.local/update-site.ts</string>
    </array>
    <key>WorkingDirectory</key><string>{{ .chezmoi.homeDir }}/dev/github.com/akameco/tokyo-babyfirst-catalog</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key><string>{{ .chezmoi.homeDir }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/babyfirst-site-update.log</string>
    <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/babyfirst-site-update.log</string>
  </dict>
</plist>
